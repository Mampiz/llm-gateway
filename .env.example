# Copy to .env and fill in. .env is gitignored.

# Where the gateway listens.
GATEWAY_ADDR=:8080

# --- Client authentication -------------------------------------------------
# Keys this gateway issues to its own callers, as name:secret pairs. The name
# identifies the caller in logs, metrics and rate limit buckets.
# Generate one with:  go run ./cmd/gateway -genkey
GATEWAY_API_KEYS=alice:gw_change_me

# Set to true to run with no authentication at all. Local development only:
# the gateway refuses to start with neither keys nor this flag, so an open
# gateway is always a deliberate choice.
# GATEWAY_AUTH_DISABLED=false

# --- Streaming --------------------------------------------------------------
# Silence tolerated from a provider before the stream is cut. Resets on every
# chunk, so a long but healthy generation is never affected.
GATEWAY_STREAM_IDLE_TIMEOUT=60s
# How often an idle stream emits a keep-alive comment.
GATEWAY_STREAM_HEARTBEAT=15s

# Fallback provider for models that match no routing prefix.
# Must be one of the providers actually configured below.
GATEWAY_PROVIDER=mock

# --- OpenAI: serves gpt-*, o1-*, o3-*, o4-*, chatgpt-* --------------------
# Leave empty to run without this provider.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint (Groq, Ollama, a mock).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic: serves claude-* -------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Anthropic requires max_tokens on every call. When a client does not send
# one, the gateway supplies this value instead of failing the request.
ANTHROPIC_DEFAULT_MAX_TOKENS=4096

# Deadline for a single non-streaming completion.
GATEWAY_REQUEST_TIMEOUT=60s

# debug | info | warn | error
GATEWAY_LOG_LEVEL=info
