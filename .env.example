# Copy to .env and fill in. .env is gitignored.

# Where the gateway listens.
GATEWAY_ADDR=:8080

# Upstream backend: "mock" (no key, no cost) or "openai".
GATEWAY_PROVIDER=mock

# Required when GATEWAY_PROVIDER=openai.
OPENAI_API_KEY=

# Optional: point at an OpenAI-compatible endpoint (Groq, Ollama, a local mock).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Deadline for a single non-streaming completion.
GATEWAY_REQUEST_TIMEOUT=60s

# debug | info | warn | error
GATEWAY_LOG_LEVEL=info
