# Copy to .env and fill in. .env is gitignored.

# Where the gateway listens.
GATEWAY_ADDR=:8080

# --- Client authentication -------------------------------------------------
# Keys this gateway issues to its own callers, as name:secret pairs. The name
# identifies the caller in logs, metrics and rate limit buckets.
# Generate one with:  go run ./cmd/gateway -genkey
GATEWAY_API_KEYS=alice:gw_change_me

# Set to true to run with no authentication at all. Local development only:
# the gateway refuses to start with neither keys nor this flag, so an open
# gateway is always a deliberate choice.
# GATEWAY_AUTH_DISABLED=false

# --- Rate limiting ---------------------------------------------------------
# Sustained per-caller allowance, in requests per second. 0 or less disables
# rate limiting entirely.
GATEWAY_RATE_LIMIT_RPS=10
# How many requests a caller may make at once after being idle.
GATEWAY_RATE_LIMIT_BURST=20
# Where the shared bucket lives. Leave empty to keep it in this process, which
# is correct for one instance and too permissive for several.
# GATEWAY_REDIS_URL=redis://localhost:6379/0

# --- Automatic fallback -----------------------------------------------------
# Which models to try when the requested one fails, in order. Falling back
# changes the model as well as the provider, because the same model rarely
# exists on two vendors.
# GATEWAY_FALLBACK_MODELS=gpt-4o-mini:claude-sonnet-5,claude-sonnet-5:gpt-4o-mini

# How many times one provider is tried before the chain moves on, first
# attempt included, and the wait before the second try. Each further attempt
# doubles it, with full jitter applied.
GATEWAY_RETRY_ATTEMPTS=2
GATEWAY_RETRY_BASE_DELAY=200ms

# Consecutive failures that take a provider out of rotation, and how long it
# is left alone before one probe is allowed through.
GATEWAY_BREAKER_THRESHOLD=5
GATEWAY_BREAKER_COOLDOWN=30s

# --- Response cache ---------------------------------------------------------
# How long a completed answer is reused. 0 disables caching entirely.
# Streaming responses are never cached.
# GATEWAY_CACHE_TTL=5m
# "shared" reuses entries across callers, "caller" keeps them private.
GATEWAY_CACHE_SCOPE=shared
# Bounds the in-process cache. Ignored when Redis backs it.
GATEWAY_CACHE_MAX_ENTRIES=1000

# --- Streaming --------------------------------------------------------------
# Silence tolerated from a provider before the stream is cut. Resets on every
# chunk, so a long but healthy generation is never affected.
GATEWAY_STREAM_IDLE_TIMEOUT=60s
# How often an idle stream emits a keep-alive comment.
GATEWAY_STREAM_HEARTBEAT=15s
# Hard cap on a whole streamed answer. The idle timeout catches an upstream
# that goes quiet; this catches one that never stops talking.
GATEWAY_STREAM_MAX_DURATION=10m

# Fallback provider for models that match no routing prefix.
# Must be one of the providers actually configured below.
GATEWAY_PROVIDER=mock

# --- OpenAI: serves gpt-*, o1-*, o3-*, o4-*, chatgpt-* --------------------
# Leave empty to run without this provider.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint (Groq, Ollama, a mock).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic: serves claude-* -------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Anthropic requires max_tokens on every call. When a client does not send
# one, the gateway supplies this value instead of failing the request.
ANTHROPIC_DEFAULT_MAX_TOKENS=4096

# Deadline for a single non-streaming completion.
GATEWAY_REQUEST_TIMEOUT=60s

# debug | info | warn | error
GATEWAY_LOG_LEVEL=info
